# Cloud Backend URL (e.g. your deployed Vercel URL or local Next.js server)
CLOUD_API_URL=https://dariy-backend.vercel.app/

# Cloud API Key for authenticating the Electron Desktop App with the Cloud Backend
CLOUD_API_KEY=your_secure_cloud_api_key_here

# Unique Device / Installation Identifier for identifying this shop terminal
APP_DEVICE_ID=dairy-desktop-terminal-1
